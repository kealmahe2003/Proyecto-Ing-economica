// ======== CHAT ENGINE ========
let msgCount = 0;

function $(id) { return document.getElementById(id); }

function toggleWidget() {
  const w = $('widget');
  const isOpen = w.classList.toggle('open');
  document.body.classList.toggle('chat-open', isOpen);
  if (isOpen) { scrollToBottom(); $('chatInput').focus(); }
}

function toggleSearch() {
  const sp = $('searchPanel');
  const cl = $('conceptList');
  const isOpen = sp.classList.toggle('open');
  cl.classList.toggle('open', isOpen);
  if (isOpen) $('searchInput').focus();
  else renderSidebar(); // reset
}

function clearChat() {
  $('chatMessages').innerHTML = '';
  msgCount = 0;
  showWelcome();
}

function scrollToBottom() {
  const el = $('chatMessages');
  requestAnimationFrame(() => { el.scrollTop = el.scrollHeight; });
}

function escapeHtml(t) {
  const d = document.createElement('div');
  d.textContent = t;
  return d.innerHTML;
}

function addMessage(content, isUser) {
  const el = $('chatMessages');
  const div = document.createElement('div');
  div.className = 'msg ' + (isUser ? 'user' : 'bot');
  div.innerHTML = '<div class="bubble">' + content + '</div>';
  el.appendChild(div);
  msgCount++;
  scrollToBottom();
}

function formatBotResponse(c) {
  let h = '<strong>' + escapeHtml(c.title) + '</strong><br><br>';
  h += escapeHtml(c.description) + '<br><br>';
  if (c.formula) {
    h += '<span class="formula">' + escapeHtml(c.formula) + '</span>';
    if (c.formulaVars) h += '<div class="vars">' + escapeHtml(c.formulaVars) + '</div>';
  }
  if (c.formulaSecondary) {
    if (c.formulaSecondaryDesc) h += '<br><div style="font-size:12px;color:#7c7cff;margin-top:4px;">▸ ' + escapeHtml(c.formulaSecondaryDesc) + '</div>';
    h += '<span class="formula">' + escapeHtml(c.formulaSecondary) + '</span>';
  }
  if (c.example) h += '<br><span class="example">📌 ' + escapeHtml(c.example) + '</span>';
  if (c.tip) h += '<br><span style="font-size:12px;color:#8888bb;">💡 ' + escapeHtml(c.tip) + '</span>';
  h += '<br><br><span class="tag">' + escapeHtml(c.category) + '</span>';
  return h;
}

function findBestMatch(query) {
  const q = query.toLowerCase().trim();
  if (!q) return null;
  let best = null, bestScore = 0;
  for (const c of concepts) {
    let score = 0;
    if (c.title.toLowerCase().includes(q)) score += 25;
    for (const kw of c.keywords) {
      if (kw.includes(q) || q.includes(kw)) { score += 18; break; }
    }
    const qWords = q.split(/\s+/);
    for (const qw of qWords) {
      if (qw.length < 3) continue;
      for (const kw of c.keywords) {
        if (kw.includes(qw)) { score += 6; break; }
      }
      if (c.description.toLowerCase().includes(qw)) score += 3;
      if (c.formula && c.formula.toLowerCase().includes(qw)) score += 4;
    }
    if (score > bestScore) { bestScore = score; best = c; }
  }
  return bestScore > 2 ? best : null;
}

function sendMessage() {
  const input = $('chatInput');
  const q = input.value.trim();
  if (!q) return;
  input.value = '';
  addMessage(escapeHtml(q), true);
  setTimeout(() => {
    const m = findBestMatch(q);
    if (m) {
      addMessage(formatBotResponse(m));
      highlightConcept(m.id);
    } else {
      let r = 'No encontré un concepto para "<em>' + escapeHtml(q) + '</em>".<br><br><strong>Conceptos disponibles:</strong><br>';
      const cats = [...new Set(concepts.map(x => x.category))];
      for (const cat of cats) {
        r += '<br><span class="tag">' + escapeHtml(cat) + '</span><br>';
        r += concepts.filter(x => x.category === cat).map(x => '• ' + escapeHtml(x.title)).join('<br>');
      }
      r += '<br><br>💡 <em>Escribe el nombre de un concepto o usa las sugerencias rápidas.</em>';
      addMessage(r);
    }
  }, 350);
}

// ======== SIDEBAR LIST ========
function renderSidebar() {
  const el = $('conceptList');
  const cats = [...new Set(concepts.map(x => x.category))];
  let h = '';
  for (const cat of cats) {
    h += '<div class="cat-title">' + escapeHtml(cat) + '</div>';
    for (const c of concepts.filter(x => x.category === cat)) {
      h += '<div class="concept-item" data-id="' + c.id + '" onclick="selectConcept(\'' + c.id + '\')">' + escapeHtml(c.title) + '</div>';
    }
  }
  el.innerHTML = h;
}

function filterConcepts() {
  const q = $('searchInput').value.toLowerCase().trim();
  $('conceptList').querySelectorAll('.concept-item').forEach(el => {
    el.style.display = el.textContent.toLowerCase().includes(q) ? 'block' : 'none';
  });
  $('conceptList').querySelectorAll('.cat-title').forEach(el => {
    let sib = el.nextElementSibling, ok = false;
    while (sib && sib.classList.contains('concept-item')) { if (sib.style.display !== 'none') ok = true; sib = sib.nextElementSibling; }
    el.style.display = ok ? 'block' : 'none';
  });
}

function highlightConcept(id) {
  $('conceptList').querySelectorAll('.concept-item').forEach(el => el.classList.remove('active'));
  const el = $('conceptList').querySelector('.concept-item[data-id="' + id + '"]');
  if (el) el.classList.add('active');
}

function selectConcept(id) {
  const c = concepts.find(x => x.id === id);
  if (!c) return;
  addMessage('📘 <strong>' + escapeHtml(c.title) + '</strong>');
  addMessage(formatBotResponse(c));
  highlightConcept(id);
}

